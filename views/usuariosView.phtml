<!-- Lista de usuarios para el admin: $usuarios viene de adminController -->
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Usuarios</title>
    <link rel="stylesheet" href="css/estilos.css">
</head>
<body>
    <?php require __DIR__ . '/header.phtml'; ?>
    <h2>Usuarios</h2>
    <table>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Email</th>
            <th>Rol</th>
            <th></th>
        </tr>
        <?php foreach ($usuarios as $u): ?>
            <tr>
                <td><?= $u->getIdUsuario() ?></td>
                <td><?= htmlspecialchars($u->getNombre()) ?> <?= htmlspecialchars($u->getApellido()) ?></td>
                <td><?= htmlspecialchars($u->getEmail()) ?></td>
                <td><?= $u->getRol() ?></td>
                <td class="acciones">
                    <!-- A uno mismo no se le puede cambiar el rol ni borrar -->
                    <?php if ($u->getIdUsuario() != $_SESSION['id_usuario']): ?>
                        <form action="index.php?page=cambiar_rol" method="post">
                            <input type="hidden" name="id_usuario" value="<?= $u->getIdUsuario() ?>">
                            <?php if ($u->getRol() == 'admin'): ?>
                                <input type="hidden" name="rol" value="usuario">
                                <input type="submit" class="btn" value="Quitar admin">
                            <?php else: ?>
                                <input type="hidden" name="rol" value="admin">
                                <input type="submit" class="btn" value="Hacer admin">
                            <?php endif; ?>
                        </form>
                        <form action="index.php?page=borrar_usuario" method="post" onsubmit="return confirm('¿Borrar este usuario? También se borran las tareas que creó.')">
                            <input type="hidden" name="id_usuario" value="<?= $u->getIdUsuario() ?>">
                            <input type="submit" class="btn btn-borrar" value="Borrar">
                        </form>
                    <?php else: ?>
                        <em>(tú)</em>
                    <?php endif; ?>
                </td>
            </tr>
        <?php endforeach; ?>
    </table>
</body>
</html>
