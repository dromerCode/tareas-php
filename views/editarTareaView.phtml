<!-- Formulario para editar una tarea: $tarea, $usuarios y $mensaje vienen de tareaController -->
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar tarea</title>
    <link rel="stylesheet" href="css/estilos.css">
</head>
<body>
    <?php require __DIR__ . '/header.phtml'; ?>
    <div class="formulario">
        <a href="index.php?page=tareas&ver=creadas">&larr; Volver</a>
        <h1>Editar tarea</h1>
        <form action="index.php?page=editar_tarea&id=<?= $tarea->getId() ?>" method="post">
            <label for="titulo">Título:</label>
            <input type="text" name="titulo" id="titulo" value="<?= htmlspecialchars($tarea->getTitulo()) ?>" required>
            <label for="descripcion">Descripción:</label>
            <textarea name="descripcion" id="descripcion" rows="4"><?= htmlspecialchars($tarea->getDescripcion() ?? '') ?></textarea>
            <label for="fecha_limite">Fecha límite:</label>
            <input type="date" name="fecha_limite" id="fecha_limite" value="<?= $tarea->getFechaLimite() ?>">
            <label for="estado">Estado:</label>
            <select name="estado" id="estado">
                <option value="pendiente" <?php if ($tarea->getEstado() == 'pendiente') echo 'selected'; ?>>Pendiente</option>
                <option value="aceptada" <?php if ($tarea->getEstado() == 'aceptada') echo 'selected'; ?>>Aceptada</option>
                <option value="completada" <?php if ($tarea->getEstado() == 'completada') echo 'selected'; ?>>Completada</option>
            </select>
            <label for="id_asignado">Asignar a:</label>
            <select name="id_asignado" id="id_asignado">
                <option value="">Nadie (cualquiera puede aceptarla)</option>
                <?php foreach ($usuarios as $u): ?>
                    <option value="<?= $u->getIdUsuario() ?>" <?php if ($tarea->getIdAsignado() == $u->getIdUsuario()) echo 'selected'; ?>><?= htmlspecialchars($u->getNombre()) ?> <?= htmlspecialchars($u->getApellido()) ?></option>
                <?php endforeach; ?>
            </select>
            <input type="submit" class="btn" value="Guardar cambios">
        </form>
        <?php if ($mensaje): ?>
            <p style="color: red;"><strong><?= htmlspecialchars($mensaje) ?></strong></p>
        <?php endif; ?>
    </div>
</body>
</html>
