<!-- Vista de login: página aparte solo con el formulario para iniciar sesión -->
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar sesión</title>
    <link rel="stylesheet" href="css/estilos.css">
</head>
<body>
    <?php require __DIR__ . '/header.phtml'; ?>
    <?php if (isset($_SESSION['id_usuario'])): ?>
        <!-- Ya ha iniciado sesión: no tiene sentido enseñar el formulario -->
        <p>Ya has iniciado sesión. <a href="index.php?page=tareas">Ver tus tareas</a></p>
    <?php else: ?>
        <div class="formulario">
            <h1>Iniciar sesión</h1>
            <form action="index.php?page=login" method="post">
                <label for="email">Email:</label>
                <input type="email" name="email" id="email" required>
                <label for="contrasena">Contraseña:</label>
                <input type="password" name="contrasena" id="contrasena" required>
                <input type="submit" class="btn" value="Iniciar sesión">
            </form>
            <?php if ($mensaje): ?>
                <p style="color: red;"><strong><?= htmlspecialchars($mensaje) ?></strong></p>
            <?php endif; ?>
            <p><a href="index.php?page=registro">Registrarse</a> para crear una cuenta.</p>
        </div>
    <?php endif; ?>
</body>
</html>
