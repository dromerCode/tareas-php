<!-- Editar tarea (admin) -->
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar tarea</title>
    <link rel="stylesheet" href="css/estilos.css">
    <script src="js/nuevaCategoria.js"></script>
</head>
<body>
    <?php require __DIR__ . '/header.phtml'; ?>
    <div class="formulario">
        <a href="index.php">&larr; Volver</a>
        <h2>Editar tarea</h2>
        <form action="index.php?var=4&id=<?= $tarea->getId() ?>" method="post">
            <!-- id de la tarea que se edita -->
            <input type="hidden" name="editar_id" value="<?= $tarea->getId() ?>">
            <label for="editar_titulo">Título:</label>
            <input type="text" name="editar_titulo" id="editar_titulo" value="<?= htmlspecialchars($tarea->getTitulo()) ?>" required>
            <label for="editar_descripcion">Descripción:</label>
            <textarea name="editar_descripcion" id="editar_descripcion" rows="3"><?= htmlspecialchars($tarea->getDescripcion()) ?></textarea>
            <label for="editar_estado">Estado:</label>
            <select name="editar_estado" id="editar_estado">
                <option value="pendiente" <?php if ($tarea->getEstado() == 'pendiente') echo 'selected'; ?>>Pendiente</option>
                <option value="aceptada" <?php if ($tarea->getEstado() == 'aceptada') echo 'selected'; ?>>Aceptada</option>
                <option value="completada" <?php if ($tarea->getEstado() == 'completada') echo 'selected'; ?>>Completada</option>
            </select>
            <label for="editar_usuario">Asignar a:</label>
            <select name="editar_usuario" id="editar_usuario">
                <?php foreach ($usuarios as $u): ?>
                    <option value="<?= $u->getId() ?>" <?php if ($u->getId() == $tarea->getIdUsuario()) echo 'selected'; ?>><?= htmlspecialchars($u->getNombre()) ?></option>
                <?php endforeach; ?>
            </select>
            <label for="editar_categoria">Categoría:</label>
            <select name="editar_categoria" id="editar_categoria" onchange="mostrarNuevaCategoria(this)">
                <option value="">Sin categoría</option>
                <?php foreach ($categorias as $cat): ?>
                    <option value="<?= $cat->getId() ?>" <?php if ($cat->getId() == $tarea->getIdCategoria()) echo 'selected'; ?>><?= htmlspecialchars($cat->getNombre()) ?></option>
                <?php endforeach; ?>
                <option value="nueva">+ Nueva categoría...</option>
            </select>
            <!-- sale al elegir "nueva categoria" -->
            <div id="caja_nueva_categoria" hidden>
                <label for="nueva_categoria">Nombre de la categoría:</label>
                <input type="text" name="nueva_categoria" id="nueva_categoria">
            </div>
            <input type="submit" class="btn" value="Guardar cambios">
        </form>
        <?php if ($mensaje): ?>
            <p class="error"><?= htmlspecialchars($mensaje) ?></p>
        <?php endif; ?>
    </div>
</body>
</html>
